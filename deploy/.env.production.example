# Production .env template for the EC2 deployment described in DEPLOY.md.
# Copy to the repo root as `.env` on the SERVER only — never commit a real
# filled-in copy of this file (it holds real secrets once filled in).
#
#   cp deploy/.env.production.example .env
#
# Then replace every CHANGE_ME value. See DEPLOY.md for exactly how to
# generate the secrets and where the sslip.io hostnames come from.

# --- Network exposure ---
# 127.0.0.1 = only nginx (and anyone with an SSH tunnel) can reach these
# ports; nothing here is exposed directly to the internet. Do not change
# this on a shared/public host.
BIND_ADDR=127.0.0.1

# --- Postgres ---
POSTGRES_USER=yrs
POSTGRES_PASSWORD=CHANGE_ME_run_openssl_rand_-hex_24
POSTGRES_DB=yrs_toys
POSTGRES_PORT=5533

# Used by `pnpm --filter @yrs/db` commands run directly on the host (e.g.
# for migrate/seed) — must match the POSTGRES_* values and port above.
DATABASE_URL=postgresql://yrs:CHANGE_ME_run_openssl_rand_-hex_24@localhost:5533/yrs_toys

# --- Mailhog (dev-grade SMTP catcher) ---
# YRS Toys does not have a real transactional-email provider wired up yet —
# order confirmations/status updates and password resets currently land in
# Mailhog's inbox instead of a real inbox. Fine for a demo/staging
# deployment; replace SMTP_HOST/SMTP_PORT with a real provider (SES,
# Postmark, etc.) before this goes in front of real customers. See
# DEPLOY.md's "Before real customers use this" section.
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8225
SMTP_HOST=mailhog
SMTP_PORT=1025
MAIL_FROM="YRS Toys <hello@yrstoys.in>"

# --- API ---
NODE_ENV=production
API_PORT=4100
JWT_ACCESS_SECRET=CHANGE_ME_run_openssl_rand_-hex_32
JWT_REFRESH_SECRET=CHANGE_ME_run_openssl_rand_-hex_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- CORS: must exactly match the storefront/admin origins browsers will
# actually load from (scheme + host, no path, no trailing slash) ---
CORS_ORIGIN_WEB=https://yrstoys.54.234.227.84.sslip.io
CORS_ORIGIN_ADMIN=https://yrstoys-admin.54.234.227.84.sslip.io

# --- Web / Admin (Vite — baked into the JS bundle at `docker compose build` time,
# so changing these requires a rebuild, not just a restart) ---
WEB_PORT=8180
ADMIN_PORT=8181
VITE_WEB_API_BASE_URL=https://yrstoys-api.54.234.227.84.sslip.io/api/v1
VITE_ADMIN_API_BASE_URL=https://yrstoys-api.54.234.227.84.sslip.io/api/v1
