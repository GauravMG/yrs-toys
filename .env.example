# Copy to .env and adjust as needed. Used by both `docker compose` and the
# plain `pnpm` dev loop (packages/db migrations, apps/api).
#
# NODE_ENV, CORS_ORIGIN_WEB and CORS_ORIGIN_ADMIN are deliberately NOT set
# here: their correct value differs between the two workflows (the plain
# `pnpm dev` loop serves the frontends on 5173/5174; the full Docker stack
# serves them via nginx on 8080/8081), and both apps/api/src/config/env.ts
# (pnpm dev) and docker-compose.yml (Docker) already default to the right
# values for their own workflow. Setting them here would make one workflow
# silently override the other's correct default — leave them unset unless
# you're deploying somewhere neither default applies (e.g. a real domain).

# --- Postgres ---
POSTGRES_USER=yrs
POSTGRES_PASSWORD=yrs_dev_password
POSTGRES_DB=yrs_toys
POSTGRES_PORT=5433

# Full connection string used directly by packages/db (Prisma) and apps/api
# when running outside Docker (pnpm dev loop). Inside docker-compose, the
# api service builds this itself pointing at the `postgres` service name.
DATABASE_URL=postgresql://yrs:yrs_dev_password@localhost:5433/yrs_toys

# Separate database used only by apps/api's integration test suite
# (truncated between test files) — never point this at dev/prod data.
TEST_DATABASE_URL=postgresql://yrs:yrs_dev_password@localhost:5433/yrs_toys_test

# --- Mailhog (dev SMTP capture) ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="YRS Toys <hello@yrstoys.in>"

# --- Adminer (dev-only DB browser, `docker compose --profile dev up`) ---
ADMINER_PORT=8082

# --- API ---
PORT=4000
API_PORT=4000
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
UPLOAD_DIR=./uploads

# --- Web / Admin (Vite) ---
WEB_PORT=8080
ADMIN_PORT=8081
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_WEB_API_BASE_URL=http://localhost:4000/api/v1
VITE_ADMIN_API_BASE_URL=http://localhost:4000/api/v1
